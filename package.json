{
  "name": "scene-studio",
  "description": "Scene Studio hosted creative tools",
  "author": "WilhelmZero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "prebuild": "npm install --include=dev",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p worker/tsconfig.json --pretty false",
    "typecheck:server": "node --check server/index.mjs && node --check server/store.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/x": "^2.3.0",
    "@google/genai": "^2.17.1",
    "@imgly/background-removal": "^1.7.0",
    "@xyflow/react": "^12.11.2",
    "ag-psd": "^27.0.0",
    "antd": "^6.1.0",
    "express": "^5.2.1",
    "imagetracerjs": "^1.2.6",
    "jszip": "^3.10.1",
    "mysql2": "^3.24.5",
    "pdf-lib": "^1.17.1",
    "pica": "^10.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "rollup": "npm:@rollup/wasm-node@^4.62.3",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
