# Hostinger Node.js Web App: configure these as server-side environment variables.
# Do not prefix secrets with VITE_. Do not commit actual values.
APP_USERS_JSON={"admin":{"passwordHash":"scrypt:<salt>:<hash>","admin":true}}
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
APP_ORIGIN=https://studio.lifelightenup.com
APP_DATA_DIR=/home/HOSTINGER_USER/domains/studio.lifelightenup.com/app-data
DB_HOST=localhost
DB_PORT=3306
DB_USER=HOSTINGER_DB_USER
DB_PASSWORD=HOSTINGER_DB_PASSWORD
DB_NAME=HOSTINGER_DB_NAME
# Optional. If absent, the per-browser key window is used.
OPENAI_API_KEY=
GEMINI_API_KEY=
